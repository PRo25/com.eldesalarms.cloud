  "author": {
    "name": "Pedro Rodrigues",
    "email": "pedrorodrigues25@me.com"
  },
  "esm": true,
  "drivers": [
    {
      "name": {
        "en": "ELDES Alarm System"
      },
      "class": "other",
      "platforms": [
        "local",
        "cloud"
      ],
      "connectivity": [
        "cloud"
      ],
      "capabilities": [
        "eldes_alarm_status",
        "eldes_alarm_arm",
        "eldes_alarm_stay_arm",
