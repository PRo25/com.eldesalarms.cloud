        "eldes_reported_armed_disarmed",
        "eldes_reported_stay_armed_disarmed",
        "eldes_active_faults",
        "eldes_unaccepted_partition_alarms"
      ],
      "pair": [
        {
          "id": "credentials"
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "repair": [
        {
          "id": "credentials"
        }
      ],
      "id": "alarm_system",
      "settings": [
        {
          "id": "api_debug_logging",
          "type": "checkbox",
          "label": {
            "en": "Log ELDES API requests and responses"
          },
          "value": true,
          "hint": {
            "en": "Logs request and response data for troubleshooting. Passwords, PINs, passphrases, and tokens are redacted."
          }
        },
        {
          "id": "poll_interval_seconds",
          "type": "number",
          "label": {
            "en": "Status polling interval"
          },
          "value": 30,
          "min": 5,
          "max": 300,
          "step": 1,
          "units": {
            "en": "seconds"
          },
          "hint": {
            "en": "How often to check the ELDES Cloud for arming status changes."
          }
        }
      ]
    },
    {
      "name": {
        "en": "ELDES Test"
      },
      "class": "sensor",
      "platforms": [
        "local",
        "cloud"
      ],
      "capabilities": [
        "eldes_test_state"
      ],
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "id": "eldes_test"
    }
  ],
